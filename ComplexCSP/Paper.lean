/-!
# Stable public bridges for the STOC manuscript

The 2026-11-06 source snapshot makes the group extensions in Lemma F.3.1
explicit and states Lemma F.5.6 for arbitrary indexed families, before its
specialization to monomial characters. These endpoints expose those statements
without depending on printed numbering in their declaration names.
-/

namespace ComplexCSP.Paper

open GeneratingSet GeneratingSet.LegalGeneratingSet
open scoped BigOperators

section Purification

/-- The exponent, root-of-unity, and prime-substitution maps of Lemma F.3.1
are homomorphisms on the entire group generated by the ambient nonzero values.
In particular their restrictions apply to the group of any distinguished
function. The formula for `purifiedHom` is the paper's formula for κ. -/
theorem purification_group_extensions {S : Finset ℂˣ} (L : LegalGeneratingSet S) :
    (∀ a : S, L.exponentHom ⟨a.val, Subgroup.subset_closure a.property⟩ =
      Multiplicative.ofAdd (L.exponents a)) ∧
    (∀ x : EntryGroup S, L.exponentHom x = 1 ↔ IsOfFinOrder x) ∧
    (∀ x : EntryGroup S, IsOfFinOrder (L.phaseHom x)) ∧
    (∀ x : EntryGroup S, IsOfFinOrder x → L.phaseHom x = x.val) ∧
    (∀ x : EntryGroup S, L.purifiedHom x = L.phaseHom x *
      complexPrimeProduct L.rank (L.exponentHom x)) ∧
    Function.Injective L.purifiedHom ∧
    (∀ x : EntryGroup S, ‖(L.purifiedHom x : ℂ)‖ = 1 ↔ IsOfFinOrder x) := by
  exact ⟨L.exponent_on_entry, L.exponent_kernel_torsion, L.phaseHom_finite_order,
    fun _ hx => L.phaseHom_torsion hx, fun _ => rfl, L.purifiedHom_injective,
    L.purifiedHom_norm_one_iff⟩

/-- The phase of a singleton purification belongs to every subfield containing
its nonzero values, and is a root of unity. This proves the final sentence of
Lemma F.3.1; it holds even without a number-field hypothesis. The field condition
on the legal generators is essential to this conclusion. -/
theorem singleton_phase_in_field {S : Finset ℂˣ} (L : LegalGeneratingSet S)
    (K : Subfield ℂ) (hK : ∀ a ∈ S, (a : ℂ) ∈ K) (x : EntryGroup S) :
    (L.phaseHom x : ℂ) ∈ K ∧ IsOfFinOrder (L.phaseHom x) := by
  have hfield : fieldOfValues S ≤ K := by
    apply Subfield.closure_le.mpr
    rintro _ ⟨a, ha, rfl⟩
    exact hK a ha
  have hx : (x.val : ℂ) ∈ K :=
    hfield (entryGroup_le_fieldUnits S x.property)
  have hg : (L.generatorHom (L.exponentHom x) : ℂ) ∈ K := by
    change (Units.coeHom ℂ) (∏ i, L.generators i ^ (L.exponentHom x).toAdd i) ∈ K
    simp only [map_prod, map_zpow, Units.coeHom_apply]
    exact K.prod_mem fun i _ => K.zpow_mem (hfield (L.generators_in_field i)) _
  refine ⟨?_, L.phaseHom_finite_order x⟩
  change (Units.coeHom ℂ) (x.val / L.generatorHom (L.exponentHom x)) ∈ K
  rw [map_div]
  exact K.div_mem hx hg

end Purification

section IndexedComparison

variable {D A B K ι V : Type} [Field K] [CharZero K]
variable [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
variable [DecidableEq K] [Fintype ι] [Fintype V]

/-- The generalized comparison in Lemma F.5.6, on the original finite instance
templates. The executable checker enumerates domain bijections and pin twins.
The indexed representation retains symbols even when tables coincide, so this
stronger statement needs neither scalar tags nor a restriction on zero tables.
It uses exact coefficient equality and permits all repeated constraints/scopes. -/
theorem indexed_family_comparison (L : Language D K ι)
    (h : (i : ι) → (Fin (L.arity i) → A) → K)
    (g : (i : ι) → (Fin (L.arity i) → B) → K)
    (a : V → A) (b : V → B) :
    (L.retarget h).pinnedIsoCheck g a b = true ↔
      ∀ (H : Type) [Fintype H] [DecidableEq H] (I : Instance L V H),
        (I.retarget h).partition a = (I.retarget g).partition b := by
  rw [PinnedIsomorphism.pinnedIsoCheck_correct_all_instances]
  constructor
  · intro he H _ _ I
    have hi := he H (I.retarget h)
    simpa only [Recognition.retarget_comp] using hi
  · intro he H _ _ J
    have hi := he H (J.retarget L.value)
    have hself : J.retarget h = J := Recognition.retarget_self J
    simpa only [Recognition.retarget_comp, hself] using hi

end IndexedComparison

section SimpleInstanceCounterexample

open Theorem52Counterexample

/-- The complete numerical counterexample in Remark F.B.1. The positive,
twin-free profiles (1,2,6) and (1,3,5) have sum nine and agree on every finite
simple labelled instance, but no domain bijection preserves their tables.
The repeated unary constraint is not simple and distinguishes them by 41
versus 35, so this result does not contradict all-instance isomorphism. -/
theorem appendix_simple_instance_counterexample :
    (∀ i, 0 < firstProfile i) ∧
    (∀ i, 0 < secondProfile i) ∧
    (∀ a b, (unaryLanguage firstProfile).Twins a b → a = b) ∧
    (∀ a b, (unaryLanguage secondProfile).Twins a b → a = b) ∧
    (∑ i, firstProfile i) = 9 ∧
    (∑ i, secondProfile i) = 9 ∧
    (∀ (H : Type) [Fintype H] [DecidableEq H]
      (I : Instance (unaryLanguage firstProfile) (Fin 1) H),
      PaperSimple I → I.partition zeroPin =
        (I.retarget (fun _ x => secondProfile (x 0))).partition zeroPin) ∧
    (¬ ∃ e : Fin 3 ≃ Fin 3,
      (unaryLanguage firstProfile).IsTargetIso (fun _ x => secondProfile (x 0)) e) ∧
    ¬ PaperSimple doubledUnary ∧
    doubledUnary.partition zeroPin = 41 ∧
    (doubledUnary.retarget (fun _ x => secondProfile (x 0))).partition zeroPin = 35 := by
  exact ⟨firstProfile_pos, secondProfile_pos, fun _ _ h => firstProfile_twinFree h,
    fun _ _ h => secondProfile_twinFree h, profile_sum_value,
    profile_sums.symm.trans profile_sum_value,
    fun _ _ _ I h => positive_profiles_all_simple_equal I h,
    positive_profiles_not_isomorphic, doubledUnary_not_simple,
    doubledUnary_first_value, doubledUnary_second_value⟩

end SimpleInstanceCounterexample

end ComplexCSP.Paper
